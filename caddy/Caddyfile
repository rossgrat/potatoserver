# Tailnet-only: grafana.grattafiori.dev resolves to the host's Tailscale IP, not Cloudflare.
# Caddy terminates TLS itself here (Cloudflare no longer does). The cert comes from Let's Encrypt
# via the Cloudflare DNS-01 challenge — the host isn't publicly reachable, and .dev is HSTS-preloaded
# so browsers refuse plain http. Requires CLOUDFLARE_API_TOKEN and the cloudflare DNS plugin.
grafana.grattafiori.dev {
	reverse_proxy lgtm:3000

	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# This network blocks 1.1.1.1/8.8.8.8 and the router hangs on NXDOMAIN, which
		# breaks ACME zone detection. Quad9 is reachable and answers cleanly.
		resolvers 9.9.9.9 149.112.112.112
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MB
			roll_keep 5
		}
		format json
	}
}

