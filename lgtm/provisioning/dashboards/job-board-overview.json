{
  "uid": "job-board-overview",
  "title": "Job Board Overview",
  "tags": ["job-board"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Jobs Fetched (by company)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(fetcher_jobs_fetched_total[5m])",
          "legendFormat": "{{company}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 30, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "id": 2,
      "title": "Jobs Created (by company)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(fetcher_jobs_created_total[5m])",
          "legendFormat": "{{company}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 30, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "id": 9,
      "title": "Jobs Soft Deleted (by company)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(fetcher_jobs_soft_deleted_total[5m])",
          "legendFormat": "{{company}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "drawStyle": "bars", "fillOpacity": 30, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "id": 3,
      "title": "Fetch Errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(fetcher_errors_total[5m])",
          "legendFormat": "{{company}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "drawStyle": "bars", "fillOpacity": 30 }
        }
      }
    },
    {
      "id": 4,
      "title": "Pipeline Tasks Completed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(outbox_tasks_completed_total{status=\"done\"}[5m])",
          "legendFormat": "{{task_name}} (done)"
        },
        {
          "expr": "rate(outbox_tasks_completed_total{status=\"failed\"}[5m])",
          "legendFormat": "{{task_name}} (failed)"
        },
        {
          "expr": "rate(outbox_tasks_completed_total{status=\"retried\"}[5m])",
          "legendFormat": "{{task_name}} (retried)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 30, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "id": 5,
      "title": "Task Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(outbox_task_duration_ms_bucket[5m]))",
          "legendFormat": "p50 {{task_name}}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(outbox_task_duration_ms_bucket[5m]))",
          "legendFormat": "p95 {{task_name}}"
        },
        {
          "expr": "histogram_quantile(0.99, rate(outbox_task_duration_ms_bucket[5m]))",
          "legendFormat": "p99 {{task_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 6,
      "title": "Totals",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 24 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(fetcher_jobs_fetched_total)",
          "legendFormat": "Jobs Fetched"
        },
        {
          "expr": "sum(fetcher_jobs_created_total)",
          "legendFormat": "Jobs Created"
        },
        {
          "expr": "sum(fetcher_jobs_soft_deleted_total)",
          "legendFormat": "Jobs Deleted"
        },
        {
          "expr": "sum(outbox_tasks_completed_total{status=\"done\"})",
          "legendFormat": "Tasks Done"
        },
        {
          "expr": "sum(outbox_tasks_completed_total{status=\"failed\"})",
          "legendFormat": "Tasks Failed"
        }
      ],
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 7,
      "title": "Logs (Worker)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=\"job-board-worker\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 8,
      "title": "Logs (API)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 38 },
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=\"job-board-api\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "schemaVersion": 39
}
